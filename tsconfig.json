{
  "compilerOptions": {
    "lib": ["ESNext"],
    "moduleResolution": "nodenext",
    "module": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "es2024",
    "types": ["mocha", "chai"]
  },
  "include": ["**/*.js"],
  "exclude": ["node_modules", "coverage"]
}
